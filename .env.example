# Copy to .env for local overrides. Every value here is public: EXPO_PUBLIC_*
# variables are inlined into the client bundle, so never put a secret in this
# file or in .env.

# Oxy API base URL. Defaults to https://api.oxy.so when unset.
EXPO_PUBLIC_API_URL=https://api.oxy.so

# The app's registered Oxy client id (an ApplicationCredential publicKey,
# oxy_dk_...). Authenticator does not have one registered yet. Signing in from
# an existing device session works without it; the cross-device Commons/QR
# sign-in route does not.
EXPO_PUBLIC_OXY_CLIENT_ID=
